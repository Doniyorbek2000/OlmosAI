# =============================================================================
# VEYRA 3D — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# The application validates these on startup and fails fast if required
# variables are missing or malformed (see packages/config).
# =============================================================================

# ---- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug

# ---- Branding (configurable so the product name can change) ------------------
VEYRA_BRAND_NAME=VEYRA 3D
VEYRA_BRAND_SHORT=Veyra
VEYRA_BRAND_DOMAIN=veyra3d.local
VEYRA_SUPPORT_EMAIL=support@veyra3d.local
VEYRA_API_KEY_PREFIX_LIVE=vyr_live_
VEYRA_API_KEY_PREFIX_TEST=vyr_test_

# ---- Web / API URLs ----------------------------------------------------------
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_BRAND_NAME=VEYRA 3D

# ---- Database (PostgreSQL) ---------------------------------------------------
DATABASE_URL=postgresql://veyra:veyra@localhost:5432/veyra?schema=public

# ---- Redis (cache + BullMQ queue) --------------------------------------------
REDIS_URL=redis://localhost:6379

# ---- Object storage (S3-compatible: AWS S3 / Cloudflare R2 / MinIO) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=veyra-assets
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/veyra-assets

# ---- Auth / JWT --------------------------------------------------------------
# Generate strong random secrets in production (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=change-me-access-secret-please-rotate
JWT_REFRESH_SECRET=change-me-refresh-secret-please-rotate
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false

# ---- OAuth providers ---------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# ---- Email (verification, password reset) ------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="VEYRA 3D <no-reply@veyra3d.local>"

# ---- Payments (Stripe first; adapters for others) ----------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
# Stripe recurring price ids per plan (used by the seed + subscription checkout).
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
# Stripe one-time price ids for credit packs (used by credit checkout).
STRIPE_PRICE_PACK_100=
STRIPE_PRICE_PACK_500=
STRIPE_PRICE_PACK_2000=

# ---- Worker <-> Orchestrator secure credentials ------------------------------
# Workers authenticate to the orchestrator with this shared secret and register
# themselves. Rotate regularly; never expose to the browser.
WORKER_SHARED_SECRET=change-me-worker-secret
ORCHESTRATOR_URL=http://localhost:5000

# ---- AI worker service endpoints (internal network only) ---------------------
TRIPOSR_WORKER_URL=http://localhost:8001
TRELLIS2_WORKER_URL=http://localhost:8002
TRIPOSG_WORKER_URL=http://localhost:8003
SF3D_WORKER_URL=http://localhost:8004
HUNYUAN3D_WORKER_URL=http://localhost:8005
HYMOTION_WORKER_URL=http://localhost:8006
HYWORLD_WORKER_URL=http://localhost:8007

# Optional: real text-to-image worker for Text-to-3D concept images. When unset,
# the API renders a deterministic procedural concept image in-process (dev/CI).
CONCEPT_IMAGE_WORKER_URL=

# ---- Feature flags (server-controlled; see packages/config) ------------------
FEATURE_TEXT_TO_3D=true
FEATURE_IMAGE_TO_3D=true
FEATURE_MULTI_IMAGE=false
FEATURE_RETEXTURE=false
FEATURE_RIGGING=false
FEATURE_MOTION=false
FEATURE_WORLD_GENERATION=false
FEATURE_PUBLIC_GALLERY=true
FEATURE_DEVELOPER_API=true

# ---- Provider enablement (also DB-driven; env is the bootstrap default) ------
PROVIDER_MOCK_ENABLED=true
PROVIDER_TRIPOSR_ENABLED=true
PROVIDER_TRELLIS2_ENABLED=false
PROVIDER_TRIPOSG_ENABLED=false
PROVIDER_SF3D_ENABLED=false
PROVIDER_HUNYUAN3D_ENABLED=false

# WARNING: the mock provider must NEVER be enabled in production.
# packages/config enforces this: PROVIDER_MOCK_ENABLED=true + NODE_ENV=production
# fails validation on startup.

# ---- Observability -----------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_METRICS_ENABLED=true

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_API_PER_MIN=60
RATE_LIMIT_UI_PER_MIN=300

# Asset-processing worker (remesh/decimate/LOD/collider/convert). When unset,
# asset-processing endpoints return PROVIDER_UNAVAILABLE.
ASSET_WORKER_URL=http://localhost:8010
